{
  "name": "mirante",
  "private": true,
  "version": "1.0.0",
  "description": "Mirante — jogo mobile 3D de escalada contemplativa",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "validate": "vitest run",
    "snapshot": "node scripts/snapshot.mjs",
    "android": "vite build && cap sync android && cap run android",
    "android:open": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "build:release": "vite build --mode release",
    "android:apk": "vite build && cap sync android && node scripts/android-apk.mjs",
    "stats": "node scripts/render-stats.mjs",
    "build:preview": "vite build --mode preview --outDir dist-preview"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "playwright": "1.63.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
